# `pnpm dev` reads backend/.env; copy this file there. Matches the `db` service in compose.yaml.
DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar
# Администратор is created at startup from these when the database has none; the app does not start without them.
# Placeholders only: set your own values in backend/.env, never commit real ones.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
